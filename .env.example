EXPO_PUBLIC_APP_ENV=development
# Physical Android/iOS: replace with your laptop's Wi-Fi IPv4 address.
EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL_MOCK=http://localhost:4011
EXPO_PUBLIC_API_BASE_URL_STAGING=
# Android emulator: http://10.0.2.2:4000; browser/iOS simulator: http://localhost:4000
# Required before production build; the dummy admin is never a production backend.
EXPO_PUBLIC_API_BASE_URL_PROD=
