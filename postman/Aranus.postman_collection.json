                                       "script":  {
                                                      "exec":  [
                                                                   "const json = pm.response.json();",
                                                                   "pm.test(\"Envelope JSON valid\", () =\u003e { pm.expect(json.success).to.be.a(\"boolean\"); pm.expect(json.message).to.be.a(\"string\"); });",
                                                                   "if (json.success \u0026\u0026 typeof json.data?.token === \"string\") pm.environment.set(\"token\", json.data.token);"
