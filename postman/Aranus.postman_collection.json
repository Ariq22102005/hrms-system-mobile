                                                                   "const saved = pm.environment.get(\"attendance_id\"); if (saved \u0026\u0026 json.success) pm.test(\"POST ID retrievable by GET\", () =\u003e pm.expect(json.data.some(row =\u003e String(row.id) === saved)).to.equal(true));"
